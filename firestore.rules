rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sauvegarde personnelle : chacun ne lit et n'écrit que la sienne.
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // File du matchmaking d'Arène : lecture pour les joueurs connectés, écriture de sa propre entrée.
    match /arenaQueue/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    // File du matchmaking de duel (duels normaux) : même principe que la file d'Arène.
    match /duelQueue/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    // Classement et journal d'Arène : lecture publique, écriture réservée à la Cloud Function « arena »
    // (le client n'écrit plus les compteurs : impossible de les falsifier depuis la console du navigateur).
    match /arenaWeeks/{week}/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
